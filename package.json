{
  "name": "artfolio-reels",
  "version": "1.0.0",
  "description": "Minimal vertical Remotion reel",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "eslint": "^9.39.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render:legacy": "remotion render ArtfolioReel output/artfolio-reel.mp4",
    "render": "tsx scripts/render-reel.ts",
    "package": "tsx scripts/package-release.ts",
    "qc": "tsx scripts/qc.ts",
    "plan": "tsx scripts/plan.ts",
    "reel": "tsx scripts/reel.ts",
    "reels:batch": "tsx scripts/reels-batch.ts",
    "reels:audit": "tsx scripts/reels-audit.ts",
    "reels:verify-release": "tsx scripts/verify-release.ts",
    "reels:history:bootstrap": "tsx scripts/bootstrap-reel-production-history.ts",
    "music:analyze": "tsx scripts/music-analyze.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:visual": "tsx scripts/test-visual.ts",
    "lint": "eslint --no-ignore src scripts tests eslint.config.mjs --ext .ts,.tsx,.js,.mjs",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "reels:repair": "tsx scripts/reels-repair.ts",
    "reels:auto": "tsx scripts/reels-auto.ts"
  },
  "sideEffects": false
}
